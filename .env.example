# Server-only production secrets. Never prefix these with NEXT_PUBLIC_.
YOUCAM_API_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
DRAPEPROOF_OWNER_HASH_SECRET=
CRON_SECRET=

# Public deployment origin used for canonical and Open Graph metadata.
DRAPEPROOF_PUBLIC_URL=https://example.com
# Optional when the CV worker is hosted at a different origin.
DRAPEPROOF_VERIFICATION_WORKER_URL=

# Production defaults. The public privacy promise assumes 24 hours.
DRAPEPROOF_SESSION_TTL_HOURS=24
DRAPEPROOF_GENERATION_ENABLED=true
DRAPEPROOF_BETA_MODE=true
DRAPEPROOF_PROVIDER_DAILY_UNIT_BUDGET=10
# Recorded authenticated feature costs are currently 2 units for each existing operation.
DRAPEPROOF_CLOTHES_V4_UNITS=2
DRAPEPROOF_BAG_V2_UNITS=2
DRAPEPROOF_ANALYTICS_RETENTION_DAYS=30
DRAPEPROOF_RATE_SESSION_CREATE_PER_HOUR=10
DRAPEPROOF_RATE_UPLOADS_PER_10_MIN=20
DRAPEPROOF_RATE_GENERATIONS_PER_HOUR=3
DRAPEPROOF_RATE_PRESERVES_PER_10_MIN=6
DRAPEPROOF_RATE_STATUS_PER_10_MIN=360

# Optional Vercel WAF in-code rate-limit instrument IDs.
DRAPEPROOF_WAF_SESSION_CREATE_ID=
DRAPEPROOF_WAF_UPLOAD_ID=
DRAPEPROOF_WAF_GENERATION_ID=
DRAPEPROOF_WAF_STATUS_ID=

# Local development only. Vercel production always selects Postgres + private Blob.
DRAPEPROOF_PERSISTENCE=local
